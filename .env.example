# =====================================================================
# Slotwise frontend — environment. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are baked into the browser bundle at build time:
# redeploy after changing them.
# =====================================================================

# Required: backend origin — no trailing slash, no /api/v1.
#   local:      http://localhost:4000
#   deployed:   https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: which business (tenant) this app books for. Seeded demo clinic by default.
NEXT_PUBLIC_BUSINESS_SLUG=lumen-clinic
